generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // dev
  url      = env("DATABASE_URL")
}

model Supplier {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  createdAt   DateTime
  closedAt    DateTime?
  active      Boolean
  logoUrl  String?
  offers      Offer[]
}

model Offer {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  startDate   DateTime
  endDate     DateTime?
  active      Boolean

  supplierId  Int
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  options     OfferOption[]
}

model OfferOption {
  id          Int     @id @default(autoincrement())
  code        String
  name        String
  description String?

  offerId     Int
  offer       Offer @relation(fields: [offerId], references: [id])

  prices      PriceComponentValue[]

  @@unique([code, offerId])
}

model MeterPower {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  kva         Int

  prices      PriceComponentValue[]
}

model TariffType {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  label       String

  prices      PriceComponentValue[]
}

model PriceComponent {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  label       String

  prices      PriceComponentValue[]
}

model PriceComponentValue {
  id              Int     @id @default(autoincrement())

  priceHt         Float
  priceTtc        Float

  startDate       DateTime
  endDate         DateTime?

  offerOptionId   Int
  offerOption     OfferOption @relation(fields: [offerOptionId], references: [id])

  meterPowerId    Int
  meterPower      MeterPower @relation(fields: [meterPowerId], references: [id])

  componentId     Int
  component       PriceComponent @relation(fields: [componentId], references: [id])

  tariffTypeId    Int
  tariffType      TariffType @relation(fields: [tariffTypeId], references: [id])
}

model ConsumptionProfile {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  annualKwh   Int
}